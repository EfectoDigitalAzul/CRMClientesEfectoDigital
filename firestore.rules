rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // GLOBAL SAFETY NET
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // PRIMITIVE HELPERS
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function isStaffEmail() {
      return isSignedIn() && getUserEmail() != null && (
        getUserEmail() == 'azul@efectodigital.com.ar' ||
        getUserEmail().matches('.*@efectodigital\\.com(\\.ar)?$')
      );
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return (userExists() && getUserData().role == role) || (role == 'director' && isStaffEmail());
    }

    function isDirector() {
      return (isSignedIn() && getUserEmail() == 'azul@efectodigital.com.ar') || isStaffEmail() || hasRole('director') || hasRole('admin');
    }

    function isAM() {
      return isDirector() || hasRole('account_manager') || hasRole('manager');
    }

    function isSetter() {
      return hasRole('setter') || isStaffEmail();
    }

    function isCommercial() {
      return hasRole('commercial') || isStaffEmail();
    }
    
    function isStaffMember() {
      return isStaffEmail() || isDirector() || isAM() || isSetter() || isCommercial() || hasRole('designer') || hasRole('copywriter');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ===============================================================
    // MATCH BLOCKS
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isDirector();
    }

    // Clients
    match /clients/{clientId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isDirector() || isAM();

      match /historyNotes/{noteId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isDirector() || isAM();
      }

      match /pautaScorecards/{scorecardId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Leads
    match /leads/{leadId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isDirector() || isAM();

      match /followUps/{followUpId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /meetings/{meetingId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Team Tasks & Client Deliverables
    match /team_tasks/{taskId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}

