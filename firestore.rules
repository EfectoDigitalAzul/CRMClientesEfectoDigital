rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // GLOBAL SAFETY NET
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // PRIMITIVE HELPERS
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaffDomain() {
      return isSignedIn() && (
        request.auth.token.email.endsWith('@efectodigital.com.ar') || 
        request.auth.token.email.endsWith('@efectodigital.com')
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isDirector() {
      return hasRole('director');
    }

    function isAM() {
      return hasRole('account_manager');
    }

    function isSetter() {
      return hasRole('setter');
    }

    function isCommercial() {
      return hasRole('commercial');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ===============================================================
    // VALIDATION HELPERS
    // ===============================================================
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 100 &&
             data.role in ['director', 'account_manager', 'setter', 'commercial', 'client'] &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidClient(data) {
      return data.name is string && data.name.size() <= 100 &&
             (data.accountManagerId == null || isValidId(data.accountManagerId));
    }

    function isValidLead(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.clientId is string && isValidId(data.clientId) &&
             data.status in ['new', 'contacted', 'follow-up', 'meeting-scheduled', 'closed-won', 'closed-lost', 'reschedule', 'qualified'];
    }

    // ===============================================================
    // MATCH BLOCKS
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow get: if true; // Enabled for custom username/password login check
      allow list: if isSignedIn();
      // Allow directors to create any user. 
      // Allow users with staff domain to create their own profile.
      // Allow AMs/Setters to create client profiles.
      allow create: if isDirector() || (isSignedIn() && request.auth.uid == userId && isStaffDomain()) || (
        (isAM() || isSetter()) && 
        request.resource.data.role == 'client' && 
        isValidUser(request.resource.data)
      );
      allow update: if isDirector() || (
        isSignedIn() && (
          request.auth.uid == userId ||
          ((isAM() || isSetter()) && resource.data.role == 'client')
        )
      );
      allow delete: if isDirector();
    }

    // Clients
    match /clients/{clientId} {
      function canAccessClient(clientData) {
        return isDirector() || 
               isAM() ||
               isSetter() ||
               isStaffDomain() ||
               (getUserData().role == 'client' && getUserData().assignedClientId == clientId);
      }

      allow read: if isSignedIn() && canAccessClient(resource.data);
      allow create: if isDirector() || isAM();
      allow update: if isDirector() || (isAM() && resource.data.accountManagerId == request.auth.uid);
      allow delete: if isDirector();

      match /historyNotes/{noteId} {
        allow read: if isSignedIn() && (isDirector() || isAM() || isSetter() || isCommercial());
        allow create: if isSignedIn() && (isDirector() || isAM() || isSetter() || isCommercial());
        allow update: if isDirector() || (isSignedIn() && resource.data.authorId == request.auth.uid);
        allow delete: if isDirector();
      }
    }

    // Leads
    match /leads/{leadId} {
      function getClient(compId) {
        return get(/databases/$(database)/documents/clients/$(compId)).data;
      }

      function canAccessLead(leadData) {
        let client = getClient(leadData.clientId);
        return isDirector() || 
               isAM() ||
               isSetter() ||
               isStaffDomain() ||
               (getUserData().role == 'client' && getUserData().assignedClientId == leadData.clientId);
      }

      allow read: if isSignedIn() && canAccessLead(resource.data);
      allow create: if isDirector() || isAM() || isSetter();
      allow update: if isDirector() || isAM() || isSetter() || isCommercial();
      allow delete: if isDirector() || (isAM() && getClient(resource.data.clientId).accountManagerId == request.auth.uid);

      match /followUps/{followUpId} {
        allow read: if isSignedIn() && canAccessLead(get(/databases/$(database)/documents/leads/$(leadId)).data);
        allow write: if isSignedIn() && canAccessLead(get(/databases/$(database)/documents/leads/$(leadId)).data);
      }

      match /meetings/{meetingId} {
        allow read: if isSignedIn() && canAccessLead(get(/databases/$(database)/documents/leads/$(leadId)).data);
        allow write: if isSignedIn() && canAccessLead(get(/databases/$(database)/documents/leads/$(leadId)).data);
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isSignedIn();
    }
  }
}
